# ---------------------------------------------------------------------------
# Part 3 - blockchain verification. Copy to `.env` and fill in real values.
# `.env` is gitignored - NEVER commit real keys.
# ---------------------------------------------------------------------------

# If RPC_URL is left blank, the code runs in LOCAL mode: an in-process eth-tester
# chain that needs no node, no keys and no funds (good for `python -m blockchain.demo_local`
# and a single-process `python pipeline.py` run). For a persistent, cross-process
# demo (recommended for the screen recording) use a real testnet below.

# --- Ethereum Sepolia testnet (recommended) ---
RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID
CHAIN_ID=11155111

# --- Polygon Amoy testnet (alternative) ---
# RPC_URL=https://rpc-amoy.polygon.technology
# CHAIN_ID=80002

# Private key of a THROWAWAY wallet that holds a little testnet ETH/MATIC.
# 64 hex chars, with or without the 0x prefix. Used only to sign transactions locally.
PRIVATE_KEY=your_test_wallet_private_key_here

# Filled in after you run:  python -m blockchain.deploy
CONTRACT_ADDRESS=

# Optional: force LOCAL mode even if RPC_URL is set (1 = on).
# BLOCKCHAIN_LOCAL=0

# Optional: set to 0 to skip the blockchain step inside pipeline.py.
# ENABLE_BLOCKCHAIN=1

# --- Part 2 credentials (owned by teammates, listed here for completeness) ---
# SERPAPI_API_KEY=your_serpapi_key
